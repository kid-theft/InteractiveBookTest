DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3-vl-plus
REPLICATE_API_TOKEN=
REPLICATE_SAM_MODEL=meta/sam-2-video
VIDEO_STORAGE_DIR=/app/storage
VIDEO_MAX_SIZE_MB=100
VIDEO_MAX_DURATION_SEC=30
VIDEO_MAX_OBJECTS=3
VIDEO_SAMPLE_INTERVAL=1.0
VIDEO_CANONICAL_FPS=24
SAM_MAX_OBJECTS=3
SAM_CONCURRENCY=2
SAM_OUTPUT_INTERVAL=1
DATABASE_URL=sqlite:////app/storage/app.db
APP_ENV=development
